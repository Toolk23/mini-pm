# --- LLM (OpenAI-совместимый API). Примеры:
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1          LLM_MODEL=deepseek-flash (или deepseek-v4-pro)
# Yandex AI Studio (open-weights): LLM_PROVIDER=yandex LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1 LLM_REASONING_EFFORT=low
#   LLM_MODEL=qwen3.6-35b-a3b  LLM_FOLDER_ID=<id каталога>  (короткое имя → gpt://<каталог>/qwen3.6-35b-a3b, авторизация Api-Key)
# OpenAI:    LLM_BASE_URL=https://api.openai.com/v1            LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_FOLDER_ID=
# DeepSeek V4 «размышляет»: low — быстрее и дешевле
LLM_REASONING_EFFORT=low
# Необязательно: своя модель на шаг агента (иначе берётся LLM_MODEL)
# LLM_MODEL_INVESTIGATION=deepseek-v4-pro
# LLM_MODEL_CHAT=deepseek-flash

# --- Yandex Search API (поиск в интернете для агента). При LLM_PROVIDER=yandex по умолчанию берутся LLM_API_KEY и LLM_FOLDER_ID
# SEARCH_API_KEY=
# SEARCH_FOLDER_ID=

# --- Яндекс.Метрика (тестовый счётчик команды)
METRIKA_TOKEN=
METRIKA_COUNTER_ID=
